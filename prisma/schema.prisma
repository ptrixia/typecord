generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// USUÁRIOS E RELACIONAMENTOS
// ------------------------------------------------------

enum UserStatus {
  ONLINE
  IDLE
  DND // Do Not Disturb
  OFFLINE
}

model GatewaySession {
  id String @id @default(uuid())

  botId String
  bot   Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  sessionTokenHash String @unique

  lastHeartbeatAt DateTime @default(now())
  expiresAt       DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([botId])
  @@index([expiresAt])
}

model Bot {
  id String @id @default(uuid())

  userId String @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User @relation("BotOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  disabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gatewaySessions GatewaySession[]

  @@index([userId])
  @@index([ownerId])
}

model Embed {
    id          String   @id @default(uuid())
    title       String?  @db.Text
    description String?  @db.Text
    url         String?  @db.Text
    color       String?
    timestamp   String?
    
    authorName  String?
    authorUrl   String?  @db.Text
    authorIcon  String?  @db.Text

    footerText  String?  @db.Text
    footerIcon  String?  @db.Text

    imageUrl    String?  @db.Text
    thumbnailUrl String? @db.Text

    fields      Json?

    messageId   String
    message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

    createdAt   DateTime @default(now())

    @@index([messageId])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String?
  globalName   String?
  avatarUrl    String?    @db.Text
  bannerUrl    String?    @db.Text
  bio          String?    @db.Text
  status       UserStatus @default(OFFLINE)

  bot          Bot?
  botsOwned Bot[] @relation("BotOwner")

  guildsOwned   Guild[]
  memberships   Member[]
  emojisCreated Emoji[]
  bans          GuildBan[]

  invitesCreated Invite[]

  friendRequestsSent     Relationship[] @relation("UserOne")
  friendRequestsReceived Relationship[] @relation("UserTwo")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
}
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum RelationshipType {
  FRIEND
  PENDING
  BLOCKED
}

model Relationship {
  id   String           @id @default(uuid())
  type RelationshipType

  userOneId String
  userOne   User   @relation("UserOne", fields: [userOneId], references: [id], onDelete: Cascade)

  userTwoId String
  userTwo   User   @relation("UserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
}

// ------------------------------------------------------
// GUILDS (SERVIDORES), CARGOS E MEMBROS
// ------------------------------------------------------

model Guild {
  id        String  @id @default(uuid())
  name      String
  iconUrl   String? @db.Text
  bannerUrl String? @db.Text
  vanityUrl String? @unique
  verified Boolean @default(false)



  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  members    Member[]
  roles      Role[]
  categories Category[]
  channels   Channel[]
  emojis     Emoji[]
  invites    Invite[]
  bans       GuildBan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Role {
  id          String  @id @default(uuid())
  name        String
  color       String  @default("#99aab5")
  hoist       Boolean @default(false)
  position    Int
  permissions String  @default("0")

  mentionable Boolean  @default(false)

  managed   Boolean @default(false)
  isDefault Boolean @default(false)

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  members Member[]

  permissionOverwrites PermissionOverwrite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([guildId, position])
}

model Member {
  id       String  @id @default(uuid())
  nickname String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  roles                Role[] // Relação Many-to-Many implícita
  permissionOverwrites PermissionOverwrite[]

  messages  Message[]
  reactions Reaction[]

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, guildId])
  @@index([userId])
  @@index([guildId])
}

// ------------------------------------------------------
// ESTRUTURA DE CANAIS
// ------------------------------------------------------

model Category {
  id       String @id @default(uuid())
  name     String
  position Int

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  channels Channel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

enum ChannelType {
  GUILD_TEXT
  GUILD_VOICE
  GUILD_VIDEO
  GUILD_ANNOUNCEMENT
  PUBLIC_THREAD
  PRIVATE_THREAD
}

model Channel {
  id       String      @id @default(uuid())
  name     String
  type     ChannelType
  topic    String?     @db.Text
  position Int
  nsfw     Boolean     @default(false)

  userLimit Int?
  bitrate   Int?

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  parentId String?
  parent   Channel?  @relation("ThreadParent", fields: [parentId], references: [id], onDelete: Cascade)
  threads  Channel[] @relation("ThreadParent")

  messages             Message[]
  permissionOverwrites PermissionOverwrite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([categoryId])
  @@index([parentId])
}

// ------------------------------------------------------
// MENSAGENS, ANEXOS E REAÇÕES
// ------------------------------------------------------

model Message {
    id        String   @id @default(uuid())
    content   String   @db.Text
    deleted   Boolean  @default(false)
    isPinned  Boolean  @default(false)

    memberId String
    member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

    channelId String
    channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

    replyToId String?
    replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
    replies   Message[] @relation("MessageReplies")

    attachments Attachment[]
    embeds      Embed[]
    reactions   Reaction[]

    createdAt DateTime  @default(now())
    editedAt  DateTime?

    @@index([channelId])
    @@index([memberId])
    @@index([replyToId])
}

model Attachment {
  id       String @id @default(uuid())
  url      String @db.Text
  filename String
  fileSize Int
  fileType String // ex: "image/png", "video/mp4"

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([messageId])
}

model Emoji {
  id   String @id @default(uuid())
  name String
  url  String @db.Text

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  reactions Reaction[]

  createdAt DateTime @default(now())

  @@index([guildId])
}

model Reaction {
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  emojiId String? // Pode ser nulo se for um emoji padrão do sistema (Unicode)
  emoji   Emoji?  @relation(fields: [emojiId], references: [id], onDelete: Cascade)
  unicode String? // Usado se for um emoji padrão (ex: "👍")

  createdAt DateTime @default(now())

  @@unique([messageId, memberId, emojiId, unicode])
  @@index([messageId])
}

// ------------------------------------------------------
// ADMINISTRAÇÃO
// ------------------------------------------------------

model Invite {
  id        String   @id @default(uuid())
  code      String   @unique

  uses      Int      @default(0)
  maxUses   Int      @default(0)

  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  creatorId String?
  creator   User?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([creatorId])
}

model GuildBan {
  id     String  @id @default(uuid())
  reason String? @db.Text

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([guildId, userId])
}

model PermissionOverwrite {
  id        String  @id @default(uuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roleId    String?
  role      Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  memberId  String?
  member    Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  allow     String  @default("0")
  deny      String  @default("0")

  @@unique([channelId, roleId])
  @@unique([channelId, memberId])
  @@index([channelId])
}

model AuditLog {
  id        String   @id @default(uuid())
  guildId   String
  actorId   String
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([actorId])
}
