generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// USUÁRIOS E RELACIONAMENTOS
// ------------------------------------------------------

enum UserStatus {
  ONLINE
  IDLE
  DND // Do Not Disturb
  OFFLINE
}

enum RichPresenceType {
  PLAYING
  LISTENING
  WATCHING
  STREAMING
  COMPETING
  CUSTOM
}

enum ScheduledEventStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELED
}

enum ScheduledEventEntityType {
  VOICE
  STAGE
  EXTERNAL
}

enum AutoModTriggerType {
  SPAM
  SUSPICIOUS_LINK
  BLOCKED_WORD
  CAPS_LOCK
  FLOOD
}

enum AutoModActionType {
  BLOCK_MESSAGE
  WARN
  TIMEOUT
}

enum ModerationActionType {
  WARNING
  TIMEOUT
}

enum NotificationType {
  MENTION
  REPLY
  ROLE_MENTION
  EVERYONE_MENTION
  PIN
  SYSTEM
}

enum MessageReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum MessageReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  THREATS
  SEXUAL_CONTENT
  ILLEGAL_CONTENT
  PERSONAL_DATA
  OTHER
}

model GatewaySession {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  botId String
  bot   Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)

  sessionTokenHash String @unique

  lastHeartbeatAt DateTime @default(now())
  expiresAt       DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([botId])
  @@index([expiresAt])
}

model Bot {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  userId String @unique
  user   User   @relation("BotAccount", fields: [userId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("BotOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  verified Boolean @default(false)

  tokenHash String @unique

  disabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gatewaySessions GatewaySession[]

  @@index([userId])
  @@index([ownerId])
}

model Embed {
  id          String  @id @default(dbgenerated("typecord_snowflake_id()"))
  title       String? @db.Text
  description String? @db.Text
  url         String? @db.Text
  color       String?
  timestamp   String?

  authorName String?
  authorUrl  String? @db.Text
  authorIcon String? @db.Text

  footerText String? @db.Text
  footerIcon String? @db.Text

  imageUrl     String? @db.Text
  thumbnailUrl String? @db.Text

  fields Json?

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([messageId])
}

model User {
  id           String     @id @default(dbgenerated("typecord_snowflake_id()"))
  email        String     @unique
  username     String     @unique
  passwordHash String?
  globalName   String?
  avatarUrl    String?    @db.Text
  bannerUrl    String?    @db.Text
  bio          String?    @db.Text
  status       UserStatus @default(OFFLINE)
  admin        Boolean    @default(false)
  twoFactorSecret  String?  @db.VarChar(64)
  twoFactorEnabled Boolean  @default(false)
  customStatus String?    @db.VarChar(128)
  e2eePublicKey String?   @db.Text

  bot       Bot?  @relation("BotAccount")
  botsOwned Bot[] @relation("BotOwner")

  guildsOwned   Guild[]
  memberships   Member[]
  emojisCreated Emoji[]
  bans          GuildBan[]

  invitesCreated Invite[]

  friendRequestsSent     Relationship[] @relation("UserOne")
  friendRequestsReceived Relationship[] @relation("UserTwo")

  directConversationsOwned       DirectConversation[]            @relation("DirectConversationOwner")
  directConversationParticipants DirectConversationParticipant[] @relation("DirectConversationParticipants")
  directConversationFolders     DirectConversationFolder[]
  directMessagesAuthored         DirectMessage[]                 @relation("DirectMessagesAuthored")
  directMessageReactions         DirectMessageReaction[]         @relation("DirectMessageReactions")
  pollVotes                      PollVote[]
  moderationActionsReceived      ModerationAction[]              @relation("ModerationActionTarget")
  moderationActionsIssued        ModerationAction[]              @relation("ModerationActionModerator")
  richPresence                   RichPresence?
  e2eeDevices                    UserDeviceKey[]

  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  emailVerified        DateTime?
  accounts             Account[]
  sessions             Session[]
  channelReadStates    ChannelReadState[]
  uploads              Upload[]
  permissionProposals  PermissionProposal[]
  channelSubscriptions ChannelSubscription[]
  installedPlugins     GuildPluginInstallation[]
  notifications        Notification[]
  messageReportsCreated MessageReport[] @relation("MessageReportsCreated")
  messageReportsReviewed MessageReport[] @relation("MessageReportsReviewed")
}

model UserDeviceKey {
  id          String    @id @default(dbgenerated("typecord_snowflake_id()"))
  userId      String
  deviceId    String    @db.VarChar(128)
  label       String?   @db.VarChar(128)
  publicKey   String    @db.Text
  fingerprint String    @db.VarChar(128)
  revokedAt   DateTime?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, revokedAt])
  @@index([fingerprint])
}

model Notification {
  id        String           @id @default(dbgenerated("typecord_snowflake_id()"))
  userId    String
  guildId   String?
  channelId String?
  messageId String?
  type      NotificationType
  title     String           @db.VarChar(200)
  content   String?          @db.Text
  href      String?          @db.Text
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([guildId, createdAt])
  @@index([messageId])
}

model PlatformLog {
  id         String   @id @default(dbgenerated("typecord_snowflake_id()"))
  level      String   @db.VarChar(16)
  event      String   @db.VarChar(160)
  message    String?  @db.Text
  requestId  String?
  route      String?
  method     String?
  status     Int?
  durationMs Int?
  userId     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([route, createdAt])
}

model RichPresence {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      RichPresenceType @default(CUSTOM)
  name      String           @db.VarChar(128)
  details   String?          @db.VarChar(128)
  state     String?          @db.VarChar(128)
  url       String?          @db.Text
  largeImageUrl String?      @db.Text
  smallImageUrl String?      @db.Text
  largeImageText String?     @db.VarChar(128)
  smallImageText String?     @db.VarChar(128)
  startedAt DateTime?
  endsAt    DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(dbgenerated("typecord_snowflake_id()"))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(dbgenerated("typecord_snowflake_id()"))
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum RelationshipType {
  FRIEND
  PENDING
  BLOCKED
}

model Relationship {
  id   String           @id @default(dbgenerated("typecord_snowflake_id()"))
  type RelationshipType

  userOneId String
  userOne   User   @relation("UserOne", fields: [userOneId], references: [id], onDelete: Cascade)

  userTwoId String
  userTwo   User   @relation("UserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
}

// ------------------------------------------------------
// MENSAGENS DIRETAS
// ------------------------------------------------------

enum DirectConversationType {
  DM
  GROUP
}

model DirectConversation {
  id      String                 @id @default(dbgenerated("typecord_snowflake_id()"))
  type    DirectConversationType
  name    String?
  iconUrl String?                @db.Text
  dmKey   String?                @unique

  ownerId String?
  owner   User?   @relation("DirectConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  participants DirectConversationParticipant[]
  messages     DirectMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([updatedAt])
}

model DirectConversationParticipant {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("DirectConversationParticipants", fields: [userId], references: [id], onDelete: Cascade)

  isHidden   Boolean   @default(false)
  isFavorite Boolean   @default(false)
  folderId   String?
  folder     DirectConversationFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model DirectConversationFolder {
  id        String   @id @default(dbgenerated("typecord_snowflake_id()"))
  userId    String
  name      String   @db.VarChar(48)
  color     String?  @db.VarChar(16)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations DirectConversationParticipant[]

  @@unique([userId, name])
  @@index([userId, position])
}

model DirectMessage {
  id      String  @id @default(dbgenerated("typecord_snowflake_id()"))
  content String  @db.Text
  deleted Boolean @default(false)

  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("DirectMessagesAuthored", fields: [authorId], references: [id], onDelete: Cascade)

  replyToId String?
  replyTo   DirectMessage?  @relation("DirectMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   DirectMessage[] @relation("DirectMessageReplies")

  attachments  DirectMessageAttachment[]
  reactions    DirectMessageReaction[]
  voiceMessage DirectVoiceMessage?

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  expiresAt DateTime?

  @@index([conversationId, createdAt])
  @@index([authorId])
  @@index([replyToId])
  @@index([expiresAt])
}

model DirectVoiceMessage {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  messageId String        @unique
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  url             String @db.Text
  durationSeconds Int
  waveform        Json?

  createdAt DateTime @default(now())
}

model DirectMessageAttachment {
  id       String @id @default(dbgenerated("typecord_snowflake_id()"))
  url      String @db.Text
  filename String
  fileSize Int
  fileType String

  messageId String
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([messageId])
}

model DirectMessageReaction {
  id    String @id @default(dbgenerated("typecord_snowflake_id()"))
  emoji String

  messageId String
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("DirectMessageReactions", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

// ------------------------------------------------------
// GUILDS (SERVIDORES), CARGOS E MEMBROS
// ------------------------------------------------------

model Guild {
  id            String  @id @default(dbgenerated("typecord_snowflake_id()"))
  name          String
  iconUrl       String? @db.Text
  bannerUrl     String? @db.Text
  accentColor   String  @default("#5865F2")
  backgroundUrl String? @db.Text
  vanityUrl     String? @unique
  verified      Boolean @default(false)
  discoverable  Boolean @default(false)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  members             Member[]
  roles               Role[]
  categories          Category[]
  channels            Channel[]
  emojis              Emoji[]
  stickers            Sticker[]
  soundboardSounds    SoundboardSound[]
  invites             Invite[]
  bans                GuildBan[]
  onboarding          GuildOnboarding?
  scheduledEvents     ScheduledEvent[]
  autoModRules        AutoModRule[]
  moderationActions   ModerationAction[]
  templates           ServerTemplate[]
  pluginInstallations GuildPluginInstallation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([discoverable])
}

model GuildPluginInstallation {
  id            String   @id @default(dbgenerated("typecord_snowflake_id()"))
  guildId       String
  pluginId      String
  version       String
  enabled       Boolean  @default(true)
  settings      Json?
  installedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild       Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  installedBy User  @relation(fields: [installedById], references: [id], onDelete: Cascade)

  @@unique([guildId, pluginId])
  @@index([guildId, enabled])
  @@index([pluginId])
}

model GuildOnboarding {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled           Boolean  @default(false)
  rules             String?  @db.Text
  questions         Json?
  suggestedChannels Json?
  autoRoleIds       String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduledEvent {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  creatorId        String?
  name             String                   @db.VarChar(100)
  description      String?                  @db.Text
  location         String?                  @db.VarChar(200)
  coverUrl         String?                  @db.Text
  entityType       ScheduledEventEntityType @default(EXTERNAL)
  channelId        String?
  scheduledStartAt DateTime
  scheduledEndAt   DateTime?
  status           ScheduledEventStatus     @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, scheduledStartAt])
  @@index([status])
}

model AutoModRule {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  name             String             @db.VarChar(100)
  enabled          Boolean            @default(true)
  triggerType      AutoModTriggerType
  actionType       AutoModActionType  @default(BLOCK_MESSAGE)
  keywords         String[]           @default([])
  exemptRoleIds    String[]           @default([])
  exemptChannelIds String[]           @default([])
  threshold        Int                @default(0)
  durationSeconds  Int?
  reason           String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([guildId, enabled])
}

model ModerationAction {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  targetUserId String
  targetUser   User   @relation("ModerationActionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  moderatorId String?
  moderator   User?   @relation("ModerationActionModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  type      ModerationActionType
  reason    String?              @db.Text
  expiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([targetUserId])
  @@index([moderatorId])
  @@index([expiresAt])
}

model Role {
  id          String  @id @default(dbgenerated("typecord_snowflake_id()"))
  name        String
  color       String  @default("#99aab5")
  hoist       Boolean @default(false)
  position    Int
  permissions String  @default("0")

  mentionable Boolean @default(false)

  managed   Boolean @default(false)
  isDefault Boolean @default(false)

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  members Member[]

  permissionOverwrites PermissionOverwrite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([guildId, position])
}

model Member {
  id       String  @id @default(dbgenerated("typecord_snowflake_id()"))
  nickname String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  roles                Role[] // Relação Many-to-Many implícita
  permissionOverwrites PermissionOverwrite[]

  messages  Message[]
  reactions Reaction[]

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, guildId])
  @@index([userId])
  @@index([guildId])
}

// ------------------------------------------------------
// ESTRUTURA DE CANAIS
// ------------------------------------------------------

model Category {
  id       String @id @default(dbgenerated("typecord_snowflake_id()"))
  name     String
  position Int

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  channels Channel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

enum ChannelType {
  GUILD_TEXT
  GUILD_VOICE
  GUILD_VIDEO
  GUILD_ANNOUNCEMENT
  PUBLIC_THREAD
  PRIVATE_THREAD
}

model Channel {
  id              String      @id @default(dbgenerated("typecord_snowflake_id()"))
  name            String
  type            ChannelType
  topic           String?     @db.Text
  position        Int
  nsfw            Boolean     @default(false)
  slowmodeSeconds Int         @default(0)
  locked          Boolean     @default(false)

  userLimit Int?
  bitrate   Int?

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  parentId String?
  parent   Channel?  @relation("ThreadParent", fields: [parentId], references: [id], onDelete: Cascade)
  threads  Channel[] @relation("ThreadParent")

  threadStarterMessageId String?  @unique
  threadStarterMessage   Message? @relation("MessageThreadStarter", fields: [threadStarterMessageId], references: [id], onDelete: SetNull)

  messages             Message[]
  permissionOverwrites PermissionOverwrite[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  temporaryExpiresAt  DateTime?
  readStates          ChannelReadState[]
  uploads             Upload[]
  permissionProposals PermissionProposal[]
  subscription        ChannelSubscription?

  @@index([guildId])
  @@index([categoryId])
  @@index([parentId])
  @@index([temporaryExpiresAt])
}

// ------------------------------------------------------
// MENSAGENS, ANEXOS E REAÇÕES
// ------------------------------------------------------

model Message {
  id       String  @id @default(dbgenerated("typecord_snowflake_id()"))
  content  String  @db.Text
  deleted  Boolean @default(false)
  isPinned Boolean @default(false)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  replyToId      String?
  replyTo        Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[] @relation("MessageReplies")
  createdThreads Channel[] @relation("MessageThreadStarter")

  attachments  Attachment[]
  embeds       Embed[]
  reactions    Reaction[]
  poll         Poll?
  voiceMessage VoiceMessage?

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  expiresAt DateTime?
  uploads   Upload[]
  reports   MessageReport[]

  @@index([channelId])
  @@index([memberId])
  @@index([replyToId])
  @@index([expiresAt])
}

model VoiceMessage {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  url             String @db.Text
  durationSeconds Int
  waveform        Json?

  createdAt DateTime @default(now())
}

model Poll {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  question      String    @db.VarChar(300)
  allowMultiple Boolean   @default(false)
  expiresAt     DateTime?

  options PollOption[]

  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model PollOption {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  label    String     @db.VarChar(120)
  position Int
  votes    PollVote[]

  @@index([pollId])
}

model PollVote {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([optionId, userId])
  @@index([userId])
}

model Attachment {
  id       String @id @default(dbgenerated("typecord_snowflake_id()"))
  url      String @db.Text
  filename String
  fileSize Int
  fileType String // ex: "image/png", "video/mp4"

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([messageId])
}

model Emoji {
  id   String @id @default(dbgenerated("typecord_snowflake_id()"))
  name String
  url  String @db.Text

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  reactions Reaction[]

  createdAt DateTime @default(now())

  @@index([guildId])
}

model Sticker {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  name        String  @db.VarChar(32)
  description String? @db.VarChar(200)
  url         String  @db.Text

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  creatorId String?

  createdAt DateTime @default(now())

  @@unique([guildId, name])
  @@index([guildId])
}

model SoundboardSound {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  name            String  @db.VarChar(32)
  emoji           String? @db.VarChar(32)
  url             String  @db.Text
  durationSeconds Int     @default(5)
  volume          Float   @default(1)

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  creatorId String?

  createdAt DateTime @default(now())

  @@unique([guildId, name])
  @@index([guildId])
}

model Reaction {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  emojiId String? // Pode ser nulo se for um emoji padrão do sistema (Unicode)
  emoji   Emoji?  @relation(fields: [emojiId], references: [id], onDelete: Cascade)
  unicode String? // Usado se for um emoji padrão (ex: "👍")

  createdAt DateTime @default(now())

  @@unique([messageId, memberId, emojiId, unicode])
  @@index([messageId])
}

// ------------------------------------------------------
// ADMINISTRAÇÃO
// ------------------------------------------------------

model Invite {
  id   String @id @default(dbgenerated("typecord_snowflake_id()"))
  code String @unique

  uses    Int @default(0)
  maxUses Int @default(0)

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([guildId])
  @@index([creatorId])
}

model GuildBan {
  id     String  @id @default(dbgenerated("typecord_snowflake_id()"))
  reason String? @db.Text

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([guildId, userId])
}

model PermissionOverwrite {
  id        String  @id @default(dbgenerated("typecord_snowflake_id()"))
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roleId    String?
  role      Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  memberId  String?
  member    Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  allow     String  @default("0")
  deny      String  @default("0")

  @@unique([channelId, roleId])
  @@unique([channelId, memberId])
  @@index([channelId])
}

model AuditLog {
  id        String   @id @default(dbgenerated("typecord_snowflake_id()"))
  guildId   String
  actorId   String
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([actorId])
}

model MessageReport {
  id         String              @id @default(dbgenerated("typecord_snowflake_id()"))
  messageId  String
  reporterId String
  guildId    String
  reason     MessageReportReason
  details    String?             @db.Text
  status     MessageReportStatus @default(OPEN)
  reviewerId String?
  resolution String?             @db.Text
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User    @relation("MessageReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("MessageReportsReviewed", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([messageId, reporterId])
  @@index([guildId, status, createdAt])
  @@index([reporterId, createdAt])
}

model ServerTemplate {
  id String @id @default(dbgenerated("typecord_snowflake_id()"))

  guildId String?
  guild   Guild?  @relation(fields: [guildId], references: [id], onDelete: SetNull)

  creatorId   String?
  name        String  @db.VarChar(100)
  description String? @db.Text
  code        String  @unique
  snapshot    Json
  uses        Int     @default(0)
  public      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([public])
}

model ChannelReadState {
  id                String   @id @default(dbgenerated("typecord_snowflake_id()"))
  userId            String
  channelId         String
  lastReadMessageId String?
  unreadCount       Int      @default(0)
  updatedAt         DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId, unreadCount])
}

model Upload {
  id        String    @id @default(dbgenerated("typecord_snowflake_id()"))
  key       String    @unique
  filename  String
  mimeType  String
  size      Int
  ownerId   String
  channelId String?
  messageId String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([messageId])
  @@index([expiresAt])
}

enum PermissionProposalStatus {
  OPEN
  APPROVED
  REJECTED
  EXPIRED
}

model PermissionProposal {
  id         String                   @id @default(dbgenerated("typecord_snowflake_id()"))
  channelId  String
  proposerId String
  permission String
  reason     String?                  @db.Text
  status     PermissionProposalStatus @default(OPEN)
  expiresAt  DateTime?
  createdAt  DateTime                 @default(now())

  channel  Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  proposer User    @relation(fields: [proposerId], references: [id], onDelete: Cascade)

  @@index([channelId, status])
  @@index([expiresAt])
}

model ChannelSubscription {
  id         String   @id @default(dbgenerated("typecord_snowflake_id()"))
  channelId  String   @unique
  creatorId  String
  priceCents Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}
