# Application
NODE_ENV="development"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-at-least-32-random-bytes"

# Database
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/typecord?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Realtime / Gateway
REALTIME_JWT_SECRET="replace-with-at-least-32-random-bytes"
GATEWAY_HOST="127.0.0.1"
GATEWAY_PORT="3001"
GATEWAY_ALLOWED_ORIGINS="http://localhost:3000"
TYPECORD_GATEWAY_PUBLIC_URL="http://localhost:3001"

# LiveKit
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="replace-me"
LIVEKIT_API_SECRET="replace-me"

# Giphy (public browser key, restrict it at the provider)
NEXT_PUBLIC_GIPHY_API_KEY="replace-me"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="typecord"
S3_ACCESS_KEY="replace-me"
S3_SECRET_KEY="replace-me"
